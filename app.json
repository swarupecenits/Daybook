{
  "expo": {
    "name": "Daybook",
    "slug": "daybook",
    "version": "1.0.0",
    "description": "A private, offline daybook for notes, tasks and money.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "daybook",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3EFE7",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "com.swarupchanda.daybook",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.swarupchanda.daybook",
      "adaptiveIcon": {
        "backgroundColor": "#F3EFE7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Daybook",
      "shortName": "Daybook",
      "themeColor": "#F3EFE7",
      "backgroundColor": "#F3EFE7"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3EFE7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 112,
          "dark": {
            "backgroundColor": "#141311",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-localization",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Daybook uses Face ID to keep your notes, tasks and money private."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#3047D8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}