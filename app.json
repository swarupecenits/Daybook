{
  "expo": {
    "name": "Daybook",
    "slug": "daybook",
    "version": "1.0.0",
    "description": "A private, offline daybook for notes, tasks and money.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "daybook",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3EFE7",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "com.swarupchanda.daybook",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.swarupchanda.daybook",
      "adaptiveIcon": {
        "backgroundColor": "#F3EFE7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Daybook",
      "shortName": "Daybook",
      "themeColor": "#F3EFE7",
      "backgroundColor": "#F3EFE7"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3EFE7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 112,
          "dark": {
            "backgroundColor": "#141311",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-localization",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Daybook uses Face ID to keep your notes, tasks and money private."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#3047D8"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["armeabi-v7a", "arm64-v8a"],
            "useLegacyPackaging": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "2a3f8dae-a286-4248-9431-8283301ebbd3"
      }
    },
    "owner": "swarupcsenits"
  }
}
